        "PvPAccepted":         { "$className": "RemoteEvent" },
        "PvPResult":           { "$className": "RemoteEvent" },

        "BuyEquipment":        { "$className": "RemoteEvent" },
        "OwnedItemsChanged":   { "$className": "RemoteEvent" },
        "NPCDrops":            { "$className": "RemoteEvent" },
        "SynthesizeCat":       { "$className": "RemoteEvent" },
        "SynthesisResult":     { "$className": "RemoteEvent" },
        "UpdateFragments":     { "$className": "RemoteEvent" }
      },

      "RemoteFunctions": {
        "$className": "Folder",
        "GetPlayerData":   { "$className": "RemoteFunction" },
        "GetShopCatalog":  { "$className": "RemoteFunction" },
        "GetOwnedItems":   { "$className": "RemoteFunction" }
      }
    }
  }
